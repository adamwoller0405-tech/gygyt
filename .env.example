# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Firebase config — get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="gygyt-hub.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gygyt-hub"
VITE_FIREBASE_STORAGE_BUCKET="gygyt-hub.firebasestorage.app"
VITE_FIREBASE_SENDER_ID="100195782150"
VITE_FIREBASE_APP_ID="1:100195782150:web:899e6472deeed8224f7d87"
